{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nguyen-vong-ai",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nguyenvongai_db",
      "database_id": "3c9c7d34-ac41-4a52-89d6-d7566bc8aa31",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CONG_DONG",
      "id": "b6281182b7ff42bc8a23deb93ffdef94"
    },
    {
      "binding": "RATE_KV",
      "id": "dd9e8bea584d4b7c8af1dbe98a617535"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "nvai-kb"
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  }
}
