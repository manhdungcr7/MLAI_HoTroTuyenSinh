# Zalo Mini App
ZALO_APP_ID=your_zalo_app_id_here
ZALO_APP_SECRET=your_zalo_app_secret_here
VITE_ZALO_APP_ID=your_zalo_app_id_here

# Tư vấn AI (OpenRouter / Anthropic / OpenAI)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Lưu ý: AI và VECTORIZE là binding Cloudflare (khai trong wrangler.jsonc), không phải biến môi trường.
# Tắt/thiếu binding thì app tự rơi về chế độ không-AI, không lỗi.
