# Trang chính luôn hỏi lại máy chủ để người dùng thấy bản mới ngay sau mỗi lần cập nhật.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
# Tệp trong /assets có mã băm trong tên nên giữ lâu được.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/sw.js
  Cache-Control: no-cache

# Bộ slide thuyết trình nội bộ (nguồn: slides/). Luôn lấy bản mới, không cho công cụ tìm kiếm lập chỉ mục.
/thuyetrinh/*
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
