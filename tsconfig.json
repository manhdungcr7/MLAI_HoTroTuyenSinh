{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./src/*"], "@cms/*": ["./cms/src/*"] }
  },
  "include": ["src", "tests", "functions", "vite.config.ts", "cms/src", "cms/functions", "cms/vite.config.ts"]
}
